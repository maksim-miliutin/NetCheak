{
    "name": "netcheck",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev:api": "npm run dev --workspace @netcheck/api",
        "dev:web": "npm run dev --workspace @netcheck/web",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p apps/api",
        "build:binary": "node tools/build-binary.mjs",
        "check:divert": "node tools/check-divert.mjs",
        "divert": "node tools/divert-run.mjs"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "postject": "^1.0.0-alpha.6",
        "vitest": "^4.1.11"
    }
}
